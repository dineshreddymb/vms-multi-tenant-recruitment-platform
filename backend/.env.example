# ==============================================================================
# VMS Backend Environment Variables Template (Production / Deployment)
# ==============================================================================

# Application Environment (production, development, testing)
ENV=production

# Database Configuration (PostgreSQL connection string)
DATABASE_URL=postgresql://<username>:<password>@<host>:<port>/<database>

# Authentication / JWT Security
JWT_SECRET=<set-in-deployment-platform>
ACCESS_TOKEN_EXPIRE_MINUTES=60

# PAN Encryption and Deterministic Hashing
PAN_ENCRYPTION_KEY=<base64-encoded-32-byte-fernet-key>
PAN_HMAC_SALT=<secure-random-salt-string>

# Platform Initial Admin Setup
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=<strong-initial-admin-password>

# AI JD Generation (Groq)
GROQ_API_KEY=<set-in-deployment-platform>
GROQ_MODEL=llama-3.3-70b-versatile

# SMTP / Email Service Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=<smtp-username>
SMTP_PASSWORD=<smtp-password>
SMTP_USE_TLS=true
EMAIL_FROM=noreply@example.com

# Password Reset URL & Token Expiration
RESET_URL_TEMPLATE=https://<frontend-domain>/auth/reset-password?token={token}
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15

# ClamAV Malware Scanning Service
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# CORS Allowed Origins (comma-separated list of allowed frontend origins)
CORS_ORIGINS=https://<frontend-domain>.vercel.app

# Object Storage Configuration (Cloudflare R2 / S3-Compatible)
STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
